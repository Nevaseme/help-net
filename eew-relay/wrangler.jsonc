{
  "name": "pland-eew-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "EewRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EewRelay"] }],
  "services": [{ "binding": "FCM_SENDER", "service": "pland-eew-relay", "entrypoint": "FcmSender" }]
}
